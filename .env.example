# Copy to .env for docker-compose.full.yml (chat + LLM).
# Do not commit real secrets.

# Go API bearer token (optional — must match api_token_env in config.yaml)
ORG_COST_API_TOKEN=

# LLM for org-cost-chat (LiteLLM org proxy)
LLM_PROVIDER=litellm
LLM_BASE_URL=https://litellm.internal/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# vLLM alternative:
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://host.docker.internal:8000/v1
# VLLM_API_KEY=EMPTY
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Frontend build arg when using docker-compose.full.yml (browser → chat agent)
VITE_CHAT_URL=http://localhost:8090
