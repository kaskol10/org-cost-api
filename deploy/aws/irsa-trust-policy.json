{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::DEPLOY_ACCOUNT_ID:oidc-provider/OIDC_PROVIDER_HOST"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "OIDC_PROVIDER_HOST:sub": "system:serviceaccount:NAMESPACE:org-cost-api",
          "OIDC_PROVIDER_HOST:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
