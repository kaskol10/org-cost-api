# Copy to frontend/.env.local for local dev when the backend uses ORG_COST_API_TOKEN.
# Must match the backend api_token / ORG_COST_API_TOKEN value.
VITE_API_TOKEN=

# Optional: API base URL when the frontend is hosted separately from the backend
# (e.g. S3 static site + separate API host). Leave empty for same-origin /api proxy.
VITE_API_URL=

# Optional: chat agent URL. Leave empty in local dev — Vite proxies /chat → :8090.
# Set for production builds, e.g. VITE_CHAT_URL=http://localhost:8090
VITE_CHAT_URL=
